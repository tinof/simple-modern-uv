{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make)",
      "Bash(make install)",
      "Bash(make fmt)",
      "Bash(make check)",
      "Bash(make typecheck)",
      "Bash(make test)",
      "Bash(make build)",
      "Bash(make lint)",
      "Bash(make lint-check)",
      "Bash(uv sync)",
      "Bash(uv sync *)",
      "Bash(uv run pytest)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run basedpyright)",
      "Bash(uv run basedpyright *)",
      "Bash(uv run codespell *)",
      "Bash(uv tree)",
      "Bash(uv tree *)",
      "Bash(UV_CONFIG_FILE=uv.toml uv run pytest *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
